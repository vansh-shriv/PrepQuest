{
  "name": "@prepquest/content",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "content": "tsx --env-file-if-exists=../../.env src/cli.ts"
  },
  "dependencies": {
    "@prepquest/analytics-core": "workspace:*",
    "@prepquest/db": "workspace:*",
    "@prepquest/shared": "workspace:*",
    "@prepquest/sql-runner": "workspace:*",
    "@prepquest/storage": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@prepquest/config": "workspace:*",
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15"
  }
}
