# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
CORS_ORIGINS=http://localhost:3000

# --- Database / cache ---
DATABASE_URL=postgresql://prepquest:prepquest@localhost:5433/prepquest
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Ed25519 keys; in development the API generates them on first start if missing.
# Paths are relative to apps/api (the working directory of `pnpm dev`).
JWT_PRIVATE_KEY_PATH=../../secrets/jwt_ed25519_private.pem
JWT_PUBLIC_KEY_PATH=../../secrets/jwt_ed25519_public.pem
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
TRUST_PROXY=false
# base64 32 bytes; encrypts TOTP seeds (dev falls back to an insecure built-in key). Required in production.
DATA_ENCRYPTION_KEY=
# Reject passwords found in breach data (Have I Been Pwned, k-anonymity). Fails open if unreachable.
BREACH_CHECK=on

# --- Rate limits (see docs/11 section 15) ---
RL_ANON_PER_MIN=120
RL_USER_PER_MIN=600
# Credential endpoints per IP per minute (refresh gets 6x)
RL_AUTH_PER_MIN=20
RL_LOGIN_PER_10MIN=10
RL_FORGOT_PER_HOUR=3

# --- OAuth (enabled when both id and secret are set) ---
# Redirect URI to register: http://localhost:4000/v1/auth/oauth/<google|github>/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Object storage (hidden test data, uploads) ---
# fs: files under STORAGE_FS_DIR (dev/test). s3: any S3-compatible server; `docker compose up -d s3` gives
# a local one on :9000 with the credentials below.
STORAGE_DRIVER=fs
STORAGE_FS_DIR=../../.data/objects
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=prepquest
S3_ACCESS_KEY=prepquest
S3_SECRET_KEY=prepquest-secret
S3_FORCE_PATH_STYLE=true

# --- Content workflow ---
# Let authors publish their own problems (off = a second reviewer must publish)
ALLOW_SELF_PUBLISH=false

# --- Email (Mailpit in dev: UI at http://localhost:8025) ---
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="PrepQuest <no-reply@prepquest.local>"

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Observability ---
LOG_LEVEL=debug

# --- LLM (mock needs no key; live needs ANTHROPIC_API_KEY) ---
LLM_MODE=mock
ANTHROPIC_API_KEY=

# --- Judge worker (apps/judge) ---
# `process` runs submitted code in a plain child process: development only, never on a shared host.
# `isolate` is the real sandbox (Linux container, see apps/judge/Dockerfile).
JUDGE_SANDBOX=process
JUDGE_CONCURRENCY=2
JUDGE_CGROUPS=false
# PYTHON_BIN=python        # override the interpreter / compiler used by the process sandbox
# CXX_BIN=g++
# JAVA_HOME=

# --- Feature flags ---
FF_VOICE=false
FF_PEER=false
FF_CONTESTS=false
FF_CANVAS=false

# Later phases extend this file (S3, judge, LLM budgets). See docs/19.
