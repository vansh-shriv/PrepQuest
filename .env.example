# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
CORS_ORIGINS=http://localhost:3000

# --- Database / cache ---
DATABASE_URL=postgresql://prepquest:prepquest@localhost:5433/prepquest
REDIS_URL=redis://localhost:6379

# --- Auth ---
# Ed25519 keys; in development the API generates them on first start if missing.
# Paths are relative to apps/api (the working directory of `pnpm dev`).
JWT_PRIVATE_KEY_PATH=../../secrets/jwt_ed25519_private.pem
JWT_PUBLIC_KEY_PATH=../../secrets/jwt_ed25519_public.pem
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TTL_DAYS=30
# Credential endpoints per IP per minute (refresh gets 6x)
RL_AUTH_PER_MIN=20

# --- Email (Mailpit in dev: UI at http://localhost:8025) ---
SMTP_URL=smtp://localhost:1025
EMAIL_FROM="PrepQuest <no-reply@prepquest.local>"

# --- Web ---
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Observability ---
LOG_LEVEL=debug

# --- LLM (mock needs no key; live needs ANTHROPIC_API_KEY) ---
LLM_MODE=mock
ANTHROPIC_API_KEY=

# --- Dev toggles ---
FAKE_JUDGE=true

# --- Feature flags ---
FF_VOICE=false
FF_PEER=false
FF_CONTESTS=false
FF_CANVAS=false

# Later phases extend this file (S3, judge, LLM budgets). See docs/19.
