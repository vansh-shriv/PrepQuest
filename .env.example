# --- App ---
NODE_ENV=development
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
API_PORT=4000
CORS_ORIGINS=http://localhost:3000

# --- Database / cache ---
DATABASE_URL=postgresql://prepquest:prepquest@localhost:5432/prepquest
REDIS_URL=redis://localhost:6379

# --- Observability ---
LOG_LEVEL=debug

# --- LLM (mock needs no key; live needs ANTHROPIC_API_KEY) ---
LLM_MODE=mock
ANTHROPIC_API_KEY=

# --- Dev toggles ---
FAKE_JUDGE=true

# --- Feature flags ---
FF_VOICE=false
FF_PEER=false
FF_CONTESTS=false
FF_CANVAS=false

# Later phases extend this file (auth keys, S3, SMTP, judge, rate limits). See docs/19.
