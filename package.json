{
  "name": "prepquest",
  "private": true,
  "packageManager": "pnpm@10.22.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:migrate": "pnpm --filter @prepquest/db db:migrate",
    "db:reset": "pnpm --filter @prepquest/db db:reset",
    "db:seed": "pnpm --filter @prepquest/api db:seed",
    "test:e2e": "pnpm --filter @prepquest/web test:e2e",
    "db:generate": "pnpm --filter @prepquest/db db:generate",
    "db:studio": "pnpm --filter @prepquest/db db:studio",
    "prepare": "husky",
    "content:validate": "pnpm --filter @prepquest/content content validate",
    "content:build-tests": "pnpm --filter @prepquest/content content build-tests",
    "content:verify": "pnpm --filter @prepquest/content content verify",
    "content:import": "pnpm --filter @prepquest/content content import",
    "content:new": "pnpm --filter @prepquest/content content new"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.9",
    "turbo": "^2.11.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^5.0.3"
  }
}
