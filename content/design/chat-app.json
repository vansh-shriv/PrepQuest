{
  "slug": "chat-app",
  "title": "Design a chat application",
  "kind": "hld",
  "difficulty": 2,
  "tags": ["realtime", "queues", "storage"],
  "statementMd": "Design a messaging app for one-to-one and group chats. Messages arrive in real time when the recipient is online and are delivered later when they are not.\n\nThink about connections, ordering, delivery guarantees, message history and presence.",
  "requirementHints": {
    "functional": [
      "Send and receive messages in real time",
      "Group chats up to 500 people",
      "Message history and offline delivery"
    ],
    "nonFunctional": [
      "Low latency delivery (under a second when online)",
      "Messages are never lost; order is kept inside a chat",
      "Millions of concurrent connections"
    ]
  },
  "reference": {
