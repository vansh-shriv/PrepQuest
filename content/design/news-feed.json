{
  "slug": "news-feed",
  "title": "Design a news feed",
  "kind": "hld",
  "difficulty": 2,
  "tags": ["fan-out", "caching", "ranking"],
  "statementMd": "Design the home feed of a social network: users follow others and see a ranked list of recent posts.\n\nThink about whether to build feeds when someone posts (fan-out on write) or when someone reads (fan-out on read), and what to do about accounts with millions of followers.",
  "requirementHints": {
    "functional": [
      "Publish a post",
      "Follow and unfollow",
      "Read a feed of recent posts from people you follow"
    ],
    "nonFunctional": [
      "Reading the feed is fast (under 200 ms)",
      "A new post shows up within a few seconds",
      "Celebrity accounts must not melt the system"
    ]
  },
