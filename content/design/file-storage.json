{
  "slug": "file-storage",
  "title": "Design a file storage and sync service",
  "kind": "hld",
  "difficulty": 3,
  "tags": ["storage", "consistency", "sync"],
  "statementMd": "Design a service like Dropbox: users keep files in the cloud, edit them on several devices and see changes everywhere.\n\nThink about large files, chunking, deduplication, conflicts when two devices edit the same file, and how devices learn about changes.",
  "requirementHints": {
    "functional": [
      "Upload and download files of any size",
      "Sync changes across devices",
      "Share files and folders"
    ],
    "nonFunctional": [
      "Never lose a file: durability above all",
      "Efficient: upload only what changed",
      "Resolve edit conflicts without losing either version"
    ]
  },
