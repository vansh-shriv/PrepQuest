{
  "slug": "url-shortener",
  "title": "Design a URL shortener",
  "kind": "hld",
  "difficulty": 1,
  "tags": ["storage", "caching", "hashing"],
  "statementMd": "Design a service like bit.ly. A user pastes a long URL and gets a short link. Opening the short link sends the browser to the long URL.\n\nStart by asking what matters: how many links per day, how long they live, whether people can pick their own alias, and whether you need click statistics.",
  "requirementHints": {
    "functional": [
      "Create a short link for a long URL",
      "Redirect a short link to the long URL",
      "Optional custom alias and expiry"
    ],
    "nonFunctional": [
      "Redirects are very fast (read-heavy, about 100 reads per write)",
      "Highly available: a dead link is a broken promise",
      "Short codes are unique and hard to guess"
    ]
  },
